{
  "name": "deckly-desktop",
  "productName": "Deckly Desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Deckly Desktop: картки для запам'ятовування, що зберігаються у файлі на комп'ютері",
  "main": "dist/main/main.js",
  "scripts": {
    "build:main": "vite build -c vite.main.config.ts --mode main && vite build -c vite.main.config.ts --mode preload",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@deckly/shared": "*",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^45.3.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.2",
    "vite": "^6.4.6"
  }
}
